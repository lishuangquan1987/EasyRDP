<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 目标启用 SIMD（System.Numerics.Vector）加速 BGRA→I420 转换，
         net40/netstandard2.0 保持纯标量兼容路径（XP/老 .NET 环境）。 -->
    <TargetFrameworks>net40;netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>5</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- net8.0 目标允许 byref/Unsafe 等 C# 7+ 语法（SIMD 转换用） -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <LangVersion>8</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EasyDesk\src\EasyDesk.Core\EasyDesk.Core.csproj" />
  </ItemGroup>

</Project>
