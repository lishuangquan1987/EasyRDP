<Window x:Class="EasyRDP.Client.Wpf.HostBrowseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyRDP 最近连接" Height="640" Width="980"
        MinHeight="400" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：品牌 + 地址栏 -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarDarkBrush}" Padding="14,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#x25CF;" Foreground="{StaticResource AccentBrush}" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="EasyRDP" Style="{StaticResource BrandTextStyle}" Margin="0,0,24,0"/>
                <TextBlock Text="HOST" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                <TextBox x:Name="HostBox" Width="220"
                         Style="{StaticResource ToolbarTextBoxStyle}"
                         ToolTip="输入 IP 或 主机名[:端口]，回车或点 Connect 连接"/>
                <Button Content="Connect" Style="{StaticResource PrimaryButtonStyle}"
                        Click="ConnectButton_Click" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 副标题 -->
        <Border Grid.Row="1" Background="#F4F6F8" BorderBrush="#DDE3E8" BorderThickness="0,0,0,1" Padding="14,8">
            <TextBlock Text="最近连接（双击直连，右键更多操作）" FontSize="14" Foreground="#4B5563"/>
        </Border>

        <!-- 缩略图网格 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl x:Name="ConnectionsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Height="170" Margin="0,0,20,20" Background="White"
                                BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="连接" Click="MenuConnect_Click"/>
                                    <MenuItem Header="删除" Click="MenuDelete_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"
                                       VerticalAlignment="Top" Height="128"/>
                                <Border Background="#F4F6F8" Height="128" VerticalAlignment="Top"
                                        BorderBrush="#DDE3E8" BorderThickness="0,0,0,1">
                                    <Path Data="M0,0 L24,0 L24,16 L0,16 Z" Fill="#9CA3AF" Stretch="Uniform"
                                          Width="48" Height="48" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,8">
                                    <TextBlock Text="{Binding Host}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1F2937" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" Foreground="#9CA3AF">
                                        <Run Text="最后连接: "/><Run Text="{Binding LastConnectedText}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部状态 -->
        <Border Grid.Row="3" Background="#F4F6F8" BorderBrush="#DDE3E8" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#6B7280"/>
        </Border>
    </Grid>
</Window>
