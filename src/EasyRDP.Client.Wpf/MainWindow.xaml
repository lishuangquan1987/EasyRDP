<Window x:Class="EasyRDP.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyRDP Client" Height="820" Width="1420"
        MinHeight="560" MinWidth="1260"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== 顶部工具栏（深色）：品牌 + 连接配置 ====== -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource ToolbarDarkBrush}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="&#x25CF;" Foreground="{StaticResource AccentBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="EasyRDP Client" Style="{StaticResource BrandTextStyle}"/>
                </StackPanel>

                <!-- 服务器配置管理 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="PROFILE" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <ComboBox Width="132"
                              Style="{StaticResource ToolbarComboBoxStyle}"
                              ItemsSource="{Binding Profiles}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProfile}"
                              Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="选择已保存的服务器配置，或输入新名称后点 Save"/>
                    <Button Content="Save" Style="{StaticResource ToolbarButtonStyle}" Height="28" Padding="8,0"
                            Command="{Binding SaveProfileCommand}" Margin="4,0,0,0"
                            ToolTip="把当前连接字段保存为配置（同名覆盖）"/>
                    <Button Content="Del" Style="{StaticResource ToolbarButtonStyle}" Height="28" Padding="8,0"
                            Command="{Binding DeleteProfileCommand}" Margin="2,0,0,0"
                            ToolTip="删除当前选中的配置"/>
                </StackPanel>

                <Separator Grid.Column="2" Style="{StaticResource ToolbarSeparatorStyle}"/>

                <!-- Host -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="HOST" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <TextBox x:Name="HostBox" Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ToolbarTextBoxStyle}" Width="132"/>
                </StackPanel>

                <!-- Port -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="PORT" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ToolbarTextBoxStyle}" Width="64"/>
                </StackPanel>

                <!-- Username -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="USER" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ToolbarTextBoxStyle}" Width="92"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="PASS" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                                 Style="{StaticResource ToolbarPasswordBoxStyle}" Width="100"/>
                </StackPanel>

                <!-- 主操作按钮 -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Connect" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ConnectCommand}" Margin="0,0,6,0"/>
                    <Button Content="Disconnect" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 信息条（浅色）：状态 + 会话指标 + 远程操作 ====== -->
        <Border x:Name="ActionBar" Grid.Row="1" Background="#F4F6F8"
                BorderBrush="#DDE3E8" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusDot" Text="&#x25CF;" FontSize="11"
                               Foreground="{StaticResource StatusIdleBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Status: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                    <TextBlock Text="Resolution: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding FrameSize}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                    <TextBlock Text="FPS: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding FrameRateText}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                    <TextBlock Text="Codec: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding CodecName}" Style="{StaticResource ActionValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- aly 自动更新：发现/下载/应用更新时显示状态，点击确认下载或应用 -->
                    <Button Content="{Binding AlyClientUpdateStr}" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding CheckUpdateCommand}" Margin="0,0,6,0"
                            Visibility="{Binding IsUpdatePanelVisible, Converter={StaticResource BoolToVis}}"
                            ToolTip="点击确认下载/应用新版本"/>
                    <Button Content="Fullscreen" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding FullscreenCommand}" Margin="0,0,6,0"
                            ToolTip="切换全屏/窗口模式（F11）"/>
                    <Button Content="Lock" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding LockCommand}" Margin="0,0,6,0"
                            ToolTip="远程锁定（Win+L）；Ctrl+Alt+Del 属系统安全序列无法模拟"/>
                    <Button Content="Alt+Tab" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding AltTabCommand}" Margin="0,0,6,0"
                            ToolTip="在远端发送 Alt+Tab 切换窗口"/>
                    <Button Content="Reset Keys" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding ResetKeysCommand}" Margin="0,0,6,0"
                            ToolTip="释放可能卡住的 Ctrl/Alt/Shift/Win 键"/>
                    <Button Content="Local Test" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding StartTestCommand}"
                            ToolTip="在本地运行渲染测试，验证管线是否正常"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 中间：桌面显示区 ====== -->
        <Border x:Name="RenderBorder" Grid.Row="2" Background="Black"
                Focusable="True">
            <Grid>
                <!-- Fant 高质量缩放：远程分辨率与窗口尺寸不一致时，线性插值会糊化文字/
                     代码高亮边缘，Fant（双三次变体）在放大/缩小时保留更多细节。
                     Stretch=Uniform 在窗口宽高比≠视频时产生 letterbox 黑边（用户允许）。
                     
                     鼠标偏移修复（v3）：WPF Image 控件即使显式 Width/Height/Alignment=Stretch，
                     ArrangeOverride 仍按内容 16:9 锁定 ActualWidth/Height（实测 Image 在
                     Border=1493x747 时仅 1327x747），导致黑框区与映射错位。
                     改用 Rectangle + ImageBrush（Rectangle 是纯几何控件必然撑满父容器），
                     ImageBrush.Stretch=Uniform 在 Rectangle 内居中留边，
                     MapCoordinates 用 Rectangle 尺寸按服务端宽高比正确扣除内部黑边。 -->
                <Rectangle x:Name="RenderImage"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           MouseMove="RenderImage_MouseMove"
                           PreviewMouseDown="RenderImage_PreviewMouseDown"
                           PreviewMouseUp="RenderImage_PreviewMouseUp"
                           MouseWheel="RenderImage_MouseWheel">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding RenderBitmap}" Stretch="Uniform"
                                    RenderOptions.BitmapScalingMode="Fant"/>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 远程光标叠加层：显示服务端光标形状/位置，盖住本地箭头光标。
                     不参与命中测试，鼠标事件仍由 RenderImage 处理。 -->
                <Image x:Name="RemoteCursorImage"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stretch="None" IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       Visibility="Collapsed"/>

                <!-- 点击位置标记（诊断）：点击后红点在按下位置显示 1.5 秒，
                     便于肉眼核对"可见光标"与"实际落点"是否一致 -->
                <Ellipse x:Name="ClickMarker"
                         Width="10" Height="10"
                         Fill="#E6FFFFFF" Stroke="#FFFF3B30" StrokeThickness="1.5"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         IsHitTestVisible="False" Visibility="Collapsed"/>

                <!-- 文件剪贴板传输进度条：叠加在桌面显示区顶部 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,0" Padding="20,10"
                        Background="#E0000000" CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsClipboardTransferring, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding ClipboardProgressText}"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"
                                   FontSize="13"/>
                        <ProgressBar Value="{Binding ClipboardProgressValue}" Maximum="100" Width="320"
                                     Style="{StaticResource AccentProgressBarStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ====== 底部状态栏（浅色）：快捷键提示 ====== -->
        <Border x:Name="BottomBar" Grid.Row="3" Background="#F4F6F8"
                BorderBrush="#DDE3E8" BorderThickness="0,1,0,0" Padding="14,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="F11 / Esc 全屏切换" Style="{StaticResource ActionLabelStyle}" Margin="0,0,16,0"/>
                <TextBlock Text="焦点在输入框时不转发键盘" Style="{StaticResource ActionLabelStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
