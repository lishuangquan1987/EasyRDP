<Window x:Class="EasyRDP.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyRDP Client" Height="720" Width="1100"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Window.Resources>
        <!-- WPF 内置转换器：bool → Visibility（IsClipboardTransferring 控制进度条可见性） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== 顶部：连接配置区 ====== -->
        <Border x:Name="TopBar" Grid.Row="0" BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Host -->
                <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Port -->
                <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="3" Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Username -->
                <TextBlock Grid.Column="4" Text="User:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="5" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Password -->
                <TextBlock Grid.Column="6" Text="Password:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <PasswordBox x:Name="PasswordBox" Grid.Column="7" PasswordChanged="PasswordBox_PasswordChanged"
                             Width="120" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- 主操作按钮 -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Width="80" Height="28" Margin="0,0,4,0"/>
                    <Button Content="Disconnect" Command="{Binding StopCommand}" Width="80" Height="28"/>
                </StackPanel>

                <!-- 分隔线 -->
                <Separator Grid.Column="9" Width="1" Background="#CCC" Margin="0,4"/>

                <!-- 次要按钮 -->
                <StackPanel Grid.Column="10" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Fullscreen" Command="{Binding FullscreenCommand}" Width="80" Height="28" Margin="0,0,4,0"
                            ToolTip="切换全屏/窗口模式"/>
                    <Button Content="Local Test" Command="{Binding StartTestCommand}" Width="80" Height="28"
                            ToolTip="在本地运行渲染测试，验证管线是否正常"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 中间：桌面显示区 ====== -->
        <Border Grid.Row="1" Background="Black"
                MouseMove="RenderImage_MouseMove"
                MouseDown="RenderImage_MouseDown"
                MouseUp="RenderImage_MouseUp"
                MouseWheel="RenderImage_MouseWheel"
                Focusable="True">
            <Grid>
                <Image x:Name="RenderImage" Source="{Binding RenderBitmap}" Stretch="Uniform"/>

                <!-- 文件剪贴板传输进度条：叠加在桌面显示区顶部，半透明黑色背景 -->
                <!-- IsHitTestVisible=False 让鼠标穿透，不拦截远程桌面点击 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,0" Padding="20,10"
                        Background="#E0000000" CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsClipboardTransferring, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding ClipboardProgressText}"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"
                                   FontSize="13"/>
                        <ProgressBar Value="{Binding ClipboardProgressValue}"
                                     Maximum="100" Width="320" Height="8"
                                     Foreground="#4CAF50" Background="#40000000"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ====== 底部：状态栏 ====== -->
        <Border x:Name="BottomBar" Grid.Row="2" Background="#F5F5F5" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Resolution: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FrameSize}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="FPS: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FrameRateText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Codec: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CodecName}" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
