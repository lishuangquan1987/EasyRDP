<Window x:Class="EasyRDP.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyRDP.Client.Wpf"
        Title="EasyRDP Client (WPF)"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp"
        Closing="OnClosing">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolConverter x:Key="InvertBool" />
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="连接" Command="{Binding ConnectCommand}" />
            <MenuItem Header="断开" Command="{Binding DisconnectCommand}" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding Status}" />
            <Separator />
            <StatusBarItem Content="{Binding Fps, StringFormat={}{0:F0} FPS}" />
        </StatusBar>

        <!-- Connect Panel -->
        <Grid Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}">
            <GroupBox Header="连接到 EasyRDP 服务端" Width="320" Height="200"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Margin="10">
                    <Label>地址</Label>
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    <Label>端口</Label>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    <Label>令牌</Label>
                    <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="连接" Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBool}}"
                            Height="30" Margin="0,10" FontWeight="Bold" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Remote Desktop -->
        <Border Background="Black" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
            <Image Source="{Binding FrameSource}" Stretch="Uniform"
                   MouseMove="OnMouseMove" MouseDown="OnMouseDown"
                   MouseUp="OnMouseUp" MouseWheel="OnMouseWheel"
                   Focusable="True" />
        </Border>
    </DockPanel>
</Window>
