<Window x:Class="EasyRDP.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyRDP Client" Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="140" Margin="0,0,6,0"/>
                <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="60" Margin="0,0,8,0"/>
                <Button Content="Connect" Command="{Binding ConnectCommand}" Width="80" Margin="0,0,4,0"/>
                <Button Content="Disconnect" Command="{Binding StopCommand}" Width="80" Margin="0,0,12,0"/>
                <Separator Width="1" Background="#CCC" Margin="0,0,12,0"/>
                <Button Content="Local Test" Command="{Binding StartTestCommand}" Width="80" Margin="0,0,4,0"
                        ToolTip="在本地运行渲染测试，验证管线是否正常"/>
                <Button Content="Fullscreen" Command="{Binding FullscreenCommand}" Width="80"/>
            </StackPanel>
        </Border>

        <!-- 桌面显示区域 -->
        <Border Grid.Row="1" Background="Black"
                MouseMove="RenderImage_MouseMove"
                MouseDown="RenderImage_MouseDown"
                MouseUp="RenderImage_MouseUp"
                MouseWheel="RenderImage_MouseWheel"
                Focusable="True">
            <Image x:Name="RenderImage" Source="{Binding RenderBitmap}" Stretch="Uniform"/>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding FrameSize}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
