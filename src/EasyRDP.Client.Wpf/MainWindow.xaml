<Window x:Class="EasyRDP.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyRDP Client" Height="820" Width="1420"
        MinHeight="560" MinWidth="1260"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== 顶部工具栏（深色）：品牌 + 连接配置 ====== -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource ToolbarDarkBrush}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="&#x25CF;" Foreground="{StaticResource AccentBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="EasyRDP Client" Style="{StaticResource BrandTextStyle}"/>
                </StackPanel>

                <!-- 服务器配置管理：已迁移到浏览窗口（控制窗口保持极简，让画面最大化） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- 兼容保留：PasswordBox 供 ViewModel 密码同步代码引用，视觉隐藏 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                                 Style="{StaticResource ToolbarPasswordBoxStyle}" Width="100"/>
                </StackPanel>

                <!-- 主操作按钮：仅断开（连接由浏览窗口发起） -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Disconnect" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 信息条（浅色）：状态 + 会话指标 + 远程操作 ====== -->
        <Border x:Name="ActionBar" Grid.Row="1" Background="#F4F6F8"
                BorderBrush="#DDE3E8" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusDot" Text="&#x25CF;" FontSize="11"
                               Foreground="{StaticResource StatusIdleBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Status: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                    <TextBlock Text="Resolution: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding FrameSize}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                    <TextBlock Text="FPS: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding FrameRateText}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                    <TextBlock Text="Codec: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding CodecName}" Style="{StaticResource ActionValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- aly 自动更新：发现/下载/应用更新时显示状态，点击确认下载或应用 -->
                    <Button Content="{Binding AlyClientUpdateStr}" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding CheckUpdateCommand}" Margin="0,0,6,0"
                            Visibility="{Binding IsUpdatePanelVisible, Converter={StaticResource BoolToVis}}"
                            ToolTip="点击确认下载/应用新版本"/>
                    <Button Content="Fullscreen" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding FullscreenCommand}" Margin="0,0,6,0"
                            ToolTip="切换全屏/窗口模式（F11）"/>
                    <Button Content="Lock" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding LockCommand}" Margin="0,0,6,0"
                            ToolTip="远程锁定（Win+L）；Ctrl+Alt+Del 属系统安全序列无法模拟"/>
                    <Button Content="Alt+Tab" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding AltTabCommand}" Margin="0,0,6,0"
                            ToolTip="在远端发送 Alt+Tab 切换窗口"/>
                    <Button Content="Reset Keys" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding ResetKeysCommand}" Margin="0,0,6,0"
                            ToolTip="释放可能卡住的 Ctrl/Alt/Shift/Win 键"/>
                    <Button Content="Local Test" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding StartTestCommand}"
                            ToolTip="在本地运行渲染测试，验证管线是否正常"/>
                    <Button Content="Details" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding ToggleDetailsCommand}" Margin="0,0,6,0"
                            ToolTip="显示/隐藏连接详情面板（网络诊断 / 连接详情 / 系统性能）"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 中间：桌面显示区 ====== -->
        <Border x:Name="RenderBorder" Grid.Row="2" Background="Black"
                Focusable="True"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
            <Grid>
                <!-- Fant 高质量缩放：远程分辨率与窗口尺寸不一致时，线性插值会糊化文字/
                     代码高亮边缘，Fant（双三次变体）在放大/缩小时保留更多细节。
                     Stretch=Uniform 在窗口宽高比≠视频时产生 letterbox 黑边（用户允许）。
                     
                     鼠标偏移修复（v3）：WPF Image 控件即使显式 Width/Height/Alignment=Stretch，
                     ArrangeOverride 仍按内容 16:9 锁定 ActualWidth/Height（实测 Image 在
                     Border=1493x747 时仅 1327x747），导致黑框区与映射错位。
                     改用 Rectangle + ImageBrush（Rectangle 是纯几何控件必然撑满父容器），
                     ImageBrush.Stretch=Uniform 在 Rectangle 内居中留边，
                     MapCoordinates 用 Rectangle 尺寸按服务端宽高比正确扣除内部黑边。 -->
                <Rectangle x:Name="RenderImage"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           MouseMove="RenderImage_MouseMove"
                           PreviewMouseDown="RenderImage_PreviewMouseDown"
                           PreviewMouseUp="RenderImage_PreviewMouseUp"
                           MouseWheel="RenderImage_MouseWheel">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding RenderBitmap}" Stretch="{Binding BrushStretch}"
                                    RenderOptions.BitmapScalingMode="Fant"/>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 悬浮工具条（RealVNC 风格）：鼠标在画面移动时出现，静止 2 秒自动隐藏。
                     叠加在远程画面上层，提供断开/全屏/远程按键/详情等快捷操作，
                     不占窗口布局空间。 -->
                <Border x:Name="FloatingToolbar"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,10,0,0" Padding="8,5"
                        Background="#CC101014" CornerRadius="6"
                        Visibility="Collapsed" IsHitTestVisible="True">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="断开" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding StopCommand}" Margin="2,0" Padding="10,4"
                                ToolTip="断开连接并关闭此窗口"/>
                        <Button Content="全屏" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding FullscreenCommand}" Margin="2,0" Padding="10,4"
                                ToolTip="切换全屏/窗口（F11）"/>
                        <Button Content="Lock" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding LockCommand}" Margin="2,0" Padding="10,4"
                                ToolTip="远程锁定（Win+L）"/>
                        <Button Content="Alt+Tab" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding AltTabCommand}" Margin="2,0" Padding="10,4"
                                ToolTip="远端发送 Alt+Tab"/>
                        <Button Content="Reset" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding ResetKeysCommand}" Margin="2,0" Padding="10,4"
                                ToolTip="释放卡住的修饰键"/>
                        <Button Content="Details" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding ToggleDetailsCommand}" Margin="2,0" Padding="10,4"
                                ToolTip="连接详情面板"/>
                        <Button Content="{Binding ZoomModeText}" Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding CycleZoomCommand}" Margin="2,0" Padding="10,4"
                                ToolTip="循环切换缩放模式：适应/原始/拉伸"/>
                    </StackPanel>
                </Border>

                <!-- 远程光标叠加层：显示服务端光标形状/位置，盖住本地箭头光标。
                     不参与命中测试，鼠标事件仍由 RenderImage 处理。 -->
                <Image x:Name="RemoteCursorImage"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Stretch="None" IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       Visibility="Collapsed"/>

                <!-- 点击位置标记（诊断）：点击后红点在按下位置显示 1.5 秒，
                     便于肉眼核对"可见光标"与"实际落点"是否一致 -->
                <Ellipse x:Name="ClickMarker"
                         Width="10" Height="10"
                         Fill="#E6FFFFFF" Stroke="#FFFF3B30" StrokeThickness="1.5"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         IsHitTestVisible="False" Visibility="Collapsed"/>

                <!-- 连接详情面板（ToDesk 风格）：网络诊断 / 连接详情 / 系统性能。
                     悬浮于桌面显示区右上角，工具栏 Details 按钮切换。
                     不参与命中测试（IsHitTestVisible=False），不干扰鼠标转发。 -->
                <Border x:Name="DetailsPanel"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,8,0" Width="380" Padding="14,10"
                        Background="#F21B1B1F" CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsDetailsPanelVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- ═══ 网络诊断 ═══ -->
                        <TextBlock Text="网络诊断" Foreground="{StaticResource AccentBrush}"
                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="连接时间" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionDurationText}" Foreground="White" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="速率" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReceiveRateText}" Foreground="White" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="帧率" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FrameRateText}" Foreground="White" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="延时" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RttText}" Foreground="White" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="丢包" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LossRateText}" Foreground="White" FontSize="12"/>
                        </Grid>

                        <!-- ═══ 连接详情 ═══ -->
                        <TextBlock Text="连接详情" Foreground="{StaticResource AccentBrush}"
                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="编解码器" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CodecDetailText}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="采集方式" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CaptureMethodText}" Foreground="White" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="色度采样" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="4:2:0 (I420)" Foreground="White" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="分辨率&amp;缩放" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RemoteResolutionText}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="画面呈现" Foreground="#B0FFFFFF" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="自动缩放 (Uniform)" Foreground="White" FontSize="12"/>
                        </Grid>

                        <!-- ═══ 系统性能 ═══ -->
                        <TextBlock Text="系统性能" Foreground="{StaticResource AccentBrush}"
                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Foreground="#B0FFFFFF" FontSize="12"/>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="{Binding LocalCpuText}" Foreground="White" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding RemoteCpuText}" Foreground="#B0FFFFFF" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" Foreground="#B0FFFFFF" FontSize="12"/>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="{Binding LocalGpuText}" Foreground="White" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding RemoteGpuText}" Foreground="#B0FFFFFF" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="内存" Foreground="#B0FFFFFF" FontSize="12"/>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="{Binding LocalMemoryText}" Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding RemoteMemoryText}" Foreground="#B0FFFFFF" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="系统" Foreground="#B0FFFFFF" FontSize="12"/>
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <TextBlock Text="{Binding LocalOsText}" Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding RemoteOsText}" Foreground="#B0FFFFFF" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="主被控" Foreground="#B0FFFFFF" FontSize="12"/>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <TextBlock Text="本机（本地）" Foreground="White" FontSize="12"/>
                                <TextBlock Text="远端（远程）" Foreground="#B0FFFFFF" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 文件剪贴板传输进度条：叠加在桌面显示区顶部 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,0" Padding="20,10"
                        Background="#E0000000" CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsClipboardTransferring, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding ClipboardProgressText}"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,6"
                                   FontSize="13"/>
                        <ProgressBar Value="{Binding ClipboardProgressValue}" Maximum="100" Width="320"
                                     Style="{StaticResource AccentProgressBarStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ====== 底部状态栏（浅色）：快捷键提示 ====== -->
        <Border x:Name="BottomBar" Grid.Row="3" Background="#F4F6F8"
                BorderBrush="#DDE3E8" BorderThickness="0,1,0,0" Padding="14,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="F11 / Esc 全屏切换" Style="{StaticResource ActionLabelStyle}" Margin="0,0,16,0"/>
                <TextBlock Text="焦点在输入框时不转发键盘" Style="{StaticResource ActionLabelStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
