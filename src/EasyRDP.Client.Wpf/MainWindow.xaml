<Window x:Class="EasyRDP.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyRDP Client" Height="650" Width="950">
    <DockPanel>
        <!-- Top panel: connection + test controls -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="HostBox" Text="127.0.0.1" Width="100" Height="24" Margin="0,0,5,0"/>
            <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="PortBox" Text="2000" Width="50" Height="24" Margin="0,0,10,0"/>
            <Button x:Name="ConnectBtn" Content="Connect" Click="ConnectBtn_Click"
                    Width="80" Height="28" Margin="0,0,10,0"/>
            <Button x:Name="StartBtn" Content="Render Test" Click="StartBtn_Click"
                    Width="90" Height="28" Margin="0,0,10,0"/>
            <Button x:Name="StopBtn" Content="Stop" Click="StopBtn_Click"
                    Width="60" Height="28" IsEnabled="False"/>
            <TextBlock x:Name="StatusText" Text="Ready" Margin="20,5,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Render area -->
        <Border BorderBrush="Gray" BorderThickness="1" Margin="10"
                MouseMove="RenderImage_MouseMove"
                MouseDown="RenderImage_MouseDown"
                MouseUp="RenderImage_MouseUp"
                MouseWheel="RenderImage_MouseWheel">
            <Image x:Name="RenderImage" Stretch="Fill"/>
        </Border>
    </DockPanel>
</Window>
