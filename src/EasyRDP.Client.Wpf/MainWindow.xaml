<Window x:Class="EasyRDP.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyRDP.Client.Wpf"
        Title="EasyRDP Client" Height="650" Width="950">
    <DockPanel>
        <!-- 顶部控制面板 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" Height="24" Margin="0,0,5,0"/>
            <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                     Width="50" Height="24" Margin="0,0,10,0"/>
            <Button Content="Connect" Command="{Binding ConnectCommand}"
                    Width="80" Height="28" Margin="0,0,10,0"/>
            <Button Content="Render Test" Command="{Binding StartTestCommand}"
                    Width="90" Height="28" Margin="0,0,10,0"/>
            <Button Content="Stop" Command="{Binding StopCommand}"
                    Width="60" Height="28"/>
            <TextBlock Text="{Binding StatusText}" Margin="20,5,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 渲染区域 -->
        <Border BorderBrush="Gray" BorderThickness="1" Margin="10"
                MouseMove="RenderImage_MouseMove"
                MouseDown="RenderImage_MouseDown"
                MouseUp="RenderImage_MouseUp"
                MouseWheel="RenderImage_MouseWheel">
            <Image x:Name="RenderImage" Source="{Binding RenderBitmap}" Stretch="Fill"/>
        </Border>
    </DockPanel>
</Window>
