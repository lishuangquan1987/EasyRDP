<Window x:Class="EasyRDP.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyRDP.Client.Wpf"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="EasyRDP Client"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp"
        Closing="OnClosing">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolConverter x:Key="InvertBool" />
        <local:AlyStatusToVisibilityConverter x:Key="AlyStatusToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="连接" Command="{Binding ConnectCommand}" />
            <MenuItem Header="断开" Command="{Binding DisconnectCommand}" />
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Padding="8,4">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#999999" />
                        <Ellipse Width="10" Height="10" Fill="#107C10"
                                 Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="{x:Static fa:IconChar.Bolt}"
                                  Foreground="#0078D4" FontSize="12"
                                  Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Foreground="#0078D4" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <Binding Path="Fps" StringFormat="{}{0:F0} FPS" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem Visibility="{Binding AlyClientStatus, Converter={StaticResource AlyStatusToVis}}">
                <Button Command="{Binding CheckUpdateCommand}"
                        Content="{Binding AlyClientUpdateStr}"
                        Padding="8,2" FontSize="12" />
            </StatusBarItem>
        </StatusBar>

        <!-- Connect Panel -->
        <Grid Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVis}}"
              Background="#F5F5F5">
            <Border Width="400" Height="Auto"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8"
                    Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Opacity="0.15" ShadowDepth="4" Direction="270" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- Title -->
                    <TextBlock Text="EasyRDP Client" FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A" />
                    <TextBlock Text="连接到远程桌面" FontSize="13" Foreground="#666666" Margin="0,2,0,16" />

                    <!-- Host -->
                    <Label>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="{x:Static fa:IconChar.Globe}"
                                          Foreground="#666666" FontSize="12"
                                          Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="地址" FontSize="13" Foreground="#666666" VerticalAlignment="Center" />
                        </StackPanel>
                    </Label>
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Port -->
                    <Label>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="{x:Static fa:IconChar.Plug}"
                                          Foreground="#666666" FontSize="12"
                                          Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="端口" FontSize="13" Foreground="#666666" VerticalAlignment="Center" />
                        </StackPanel>
                    </Label>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Token -->
                    <Label>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="{x:Static fa:IconChar.Key}"
                                          Foreground="#666666" FontSize="12"
                                          Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="令牌" FontSize="13" Foreground="#666666" VerticalAlignment="Center" />
                        </StackPanel>
                    </Label>
                    <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Connect Button -->
                    <Button Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBool}}"
                            Height="36" Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fa:IconBlock Icon="{x:Static fa:IconChar.Play}"
                                          Foreground="White" FontSize="14"
                                          Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="连 接" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                                <Setter Property="Text" Value="连接中..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Remote Desktop -->
        <Border Background="#1A1A1A" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                BorderBrush="#2A2A2A" BorderThickness="1">
            <Image Source="{Binding FrameSource}" Stretch="Uniform"
                   MouseMove="OnMouseMove" MouseDown="OnMouseDown"
                   MouseUp="OnMouseUp" MouseWheel="OnMouseWheel"
                   Focusable="True" />
        </Border>
    </DockPanel>
</Window>
