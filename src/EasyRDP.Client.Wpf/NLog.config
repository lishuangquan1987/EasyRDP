<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false">

  <targets>
    <!-- D18 日志降量：生产默认 minlevel=Info（与 Server 端一致）。DEBUG 日志
         （每帧渲染统计/逐条收发/鼠标移动）占客户端单会话日志 99%，格式化+队列+
         磁盘 IO 拖慢弱机。排查问题时临时改回 Debug 即可获得全量细节。 -->
    <target xsi:type="AsyncWrapper" name="asyncLog" queueLimit="2000" overflowAction="Discard">
      <target name="logfile" xsi:type="File"
              fileName="${basedir}/Logs/easyrdp-client-${shortdate}.log"
              layout="${longdate} [${level:uppercase=true}] ${logger} - ${message} ${exception:format=tostring}"
              archiveEvery="Day"
              maxArchiveFiles="7"
              encoding="utf-8" />
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="asyncLog" />
  </rules>
</nlog>
