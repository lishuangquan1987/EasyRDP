<Window
    x:Class="EasyRDP.Client.Wpf.Views.HostBrowseWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:EasyRDP.Client.Wpf.Behaviors"
    Title="EasyRDP Viewer"
    Width="1200"
    Height="720"
    MinWidth="900"
    MinHeight="480"
    Background="#FFFFFF"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--
            卡片缩略图与 IP 模板（1:1 复刻 RealVNC Viewer 缩略图网格）。
            Tag 承载 Window 的 DataContext（ViewModel），供 ContextMenu 通过
            PlacementTarget.Tag 解析 ViewModel 命令（ContextMenu 不在视觉树内，
            无法直接用 RelativeSource AncestorType）。
        -->
        <DataTemplate x:Key="ThumbCardTemplate">
            <Border
                x:Name="CardBorder"
                Width="200"
                Height="180"
                Margin="12,10"
                behaviors:ClickCommand.Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                behaviors:DoubleClickCommand.Command="{Binding DataContext.ConnectItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                Background="White"
                Cursor="Hand"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <!--  ListBox Item 风格交互：鼠标移入高亮背景，选中态更明显  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F1FC" />
                                <Setter Property="BorderBrush" Value="#9DC3E6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#D6E7F7" />
                                <Setter Property="BorderBrush" Value="#5B9BD5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.ConnectItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="Connect" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.EditItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="Edit..." />
                        <Separator />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.RenameItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="Rename" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="Delete" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  缩略图（正方形，未加载时显示占位图标）  -->
                    <Grid Grid.Row="0" Margin="4">
                        <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" />
                        <Border x:Name="ThumbPlaceholder" Background="#F2F4F6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="40"
                                    Foreground="#9CA3AF"
                                    Text="&#xE770;" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#9CA3AF"
                                    Text="无预览" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!--  IP 地址（居中，卡片底部；重命名后显示 DisplayName）  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,6,0,8"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="#263238"
                        Text="{Binding DisplayText}" />
                    <!--  左上角活动状态红点  -->
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="9"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="#E4002B"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!--  ====== 菜单栏：File / View / Help（严格 MVVM：全部走命令） ======  -->
        <Menu
            Height="26"
            Background="#F7F8FA"
            BorderBrush="#E2E6EA"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Command="{Binding NewConnectionCommand}" Header="New Connection..." />
                <MenuItem Command="{Binding RefreshCommand}" Header="Refresh Thumbnails" />
                <Separator />
                <MenuItem Command="{Binding ExitCommand}" Header="Exit" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Command="{Binding RefreshCommand}" Header="Refresh" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Command="{Binding AboutCommand}" Header="About" />
            </MenuItem>
        </Menu>

        <!--  ====== 品牌行：logo + 地址输入框 + Sign in ======  -->
        <Border
            Padding="16,10"
            Background="White"
            BorderBrush="#E2E6EA"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  vnc connect 品牌  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="#E4002B"
                        Text="&#x25CF;" />
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#263238">
                        <Run Text="easyrdp" /><Run
                            FontWeight="Normal"
                            Foreground="#607D8B"
                            Text=" connect" />
                    </TextBlock>
                </StackPanel>
                <!--  长地址输入框（蓝色高亮选中 IP），回车连接  -->
                <TextBox
                    x:Name="HostBox"
                    Grid.Column="1"
                    Height="30"
                    Margin="0,0,16,0"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    Background="#F5F7F9"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    FontSize="13"
                    Text="{Binding AddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="输入 IP、host[:port] 或 user@host[:port]，回车或点 Connect 连接">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConnectAddressCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <!--  连接按钮（显式可点击，避免只靠回车不直观）  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        Height="30"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Command="{Binding ConnectAddressCommand}"
                        Content="Connect"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="连接地址栏输入的主机（输入 IP 后会自动弹出表单填写端口/用户名/密码）" />
                    <!--  Sign in...（视觉占位，与 RealVNC 一致）  -->
                    <Button
                        Height="30"
                        Padding="12,0"
                        Background="Transparent"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        Command="{Binding SignInCommand}"
                        Content="Sign in..."
                        FontSize="13"
                        Foreground="#37474F" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ====== 主体：白色滚动区，5 列缩略图网格 ======  -->
        <ScrollViewer
            Padding="8,12"
            Background="White"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemTemplate="{StaticResource ThumbCardTemplate}" ItemsSource="{Binding Connections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
