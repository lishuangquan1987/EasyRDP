<Window
    x:Class="EasyRDP.Client.Wpf.Views.HostBrowseWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:EasyRDP.Client.Wpf.Behaviors"
    Title="EasyRDP Viewer"
    Width="1200"
    Height="720"
    MinWidth="900"
    MinHeight="480"
    Background="#FFFFFF"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--
            卡片缩略图与 IP 模板（1:1 复刻 RealVNC Viewer 缩略图网格）。
            Tag 承载 Window 的 DataContext（ViewModel），供 ContextMenu 通过
            PlacementTarget.Tag 解析 ViewModel 命令（ContextMenu 不在视觉树内，
            无法直接用 RelativeSource AncestorType）。
        -->
        <DataTemplate x:Key="ThumbCardTemplate">
            <Border
                x:Name="CardBorder"
                Width="200"
                Height="180"
                Margin="12,10"
                behaviors:ClickCommand.Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                behaviors:DoubleClickCommand.Command="{Binding DataContext.ConnectItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                Background="White"
                Cursor="Hand"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <!--  ListBox Item 风格交互：鼠标移入高亮背景，选中态更明显  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E8F1FC" />
                                <Setter Property="BorderBrush" Value="#9DC3E6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#D6E7F7" />
                                <Setter Property="BorderBrush" Value="#5B9BD5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.ConnectItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="Connect" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.EditItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="Edit..." />
                        <Separator />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.RenameItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="Rename" />
                        <MenuItem
                            Command="{Binding PlacementTarget.Tag.DeleteItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            Header="Delete" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  缩略图（正方形，未加载时显示占位图标）  -->
                    <Grid Grid.Row="0" Margin="4">
                        <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" />
                        <Border x:Name="ThumbPlaceholder" Background="#F2F4F6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="40"
                                    Foreground="#9CA3AF"
                                    Text="&#xE770;" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#9CA3AF"
                                    Text="No preview" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!--  IP 地址（居中，卡片底部；重命名后显示 DisplayName）  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,6,0,8"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="#263238"
                        Text="{Binding DisplayText}" />
                    <!--  左上角活动状态红点  -->
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="9"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="#E4002B"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!--  ====== 菜单栏：File / View / Help（严格 MVVM：全部走命令） ======  -->
        <Menu
            Height="26"
            Background="#F7F8FA"
            BorderBrush="#E2E6EA"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Command="{Binding NewConnectionCommand}" Header="New Connection..." />
                <MenuItem Command="{Binding RefreshCommand}" Header="Refresh Thumbnails" />
                <Separator />
                <MenuItem Command="{Binding ExitCommand}" Header="Exit" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Command="{Binding RefreshCommand}" Header="Refresh" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Command="{Binding AboutCommand}" Header="About" />
            </MenuItem>
        </Menu>

        <!--  ====== 品牌行：logo + 在线统计 + 新建分组/连接（连接必须先有连接信息）  ======  -->
        <Border
            Padding="16,10"
            Background="White"
            BorderBrush="#E2E6EA"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="#E4002B"
                        Text="&#x25CF;" />
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#263238">
                        <Run Text="easyrdp" /><Run
                            FontWeight="Normal"
                            Foreground="#607D8B"
                            Text=" connect" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AvailabilitySummary}"
                               FontSize="11" Foreground="#78909C" VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               ToolTip="TCP probe result for each saved connection" />
                    <Button Height="28" Padding="10,0" Content="+ Group"
                            Command="{Binding NewGroupCommand}"
                            Style="{StaticResource LightButtonStyle}" Margin="0,0,6,0"
                            ToolTip="Create a connection group" />
                    <Button Height="28" Padding="10,0" Content="+ Connection"
                            Command="{Binding NewConnectionCommand}"
                            Style="{StaticResource LightButtonStyle}"
                            ToolTip="Create a saved connection (host / port / user / password)" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ====== 顶部横条：左 RECENT（历史连接）+ 右 DISCOVERED（局域网发现，已配置去重）  ======  -->
        <Border DockPanel.Dock="Top" Padding="16,8"
                Background="#F8FAFC" BorderBrush="#E2E6EA" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Recent  -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Left" Text="RECENT" VerticalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold" Foreground="#90A4AE" Margin="0,0,14,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock Text="No recent connections" FontSize="12" Foreground="#C2CDD6"
                                       VerticalAlignment="Center" Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowNoRecentHint}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Recents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0" Margin="0,0,10,0" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.ConnectItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Connect to this host again">
                                            <StackPanel Width="112">
                                                <Border Width="112" Height="63" Background="#0B1220" CornerRadius="4">
                                                    <Grid>
                                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="18" Foreground="#5B7083"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Host}" FontSize="12" Foreground="#263238"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding Port}" FontSize="10" Foreground="#90A4AE" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Column="1" Width="1" Background="#E2E6EA" Margin="14,0" />

                <!--  Discovered  -->
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Left" Text="DISCOVERED" VerticalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,10,0" />
                    <Button DockPanel.Dock="Right" Content="Scan" Height="26" Padding="10,0"
                            Command="{Binding DiscoverCommand}"
                            Style="{StaticResource LightButtonStyle}" VerticalAlignment="Center"
                            ToolTip="Scan the local network for EasyRDP servers (UDP broadcast)" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DiscoveryStatusText}"
                               FontSize="11" Foreground="#78909C" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <Grid>
                            <TextBlock Text="No servers found on the LAN" FontSize="12" Foreground="#C2CDD6"
                                       VerticalAlignment="Center" Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsScanning}" Value="False" />
                                                    <Condition Binding="{Binding DiscoveryStatusText}" Value="Click Scan" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Discovered}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0" Margin="0,0,10,0" Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.AddDiscoveredCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Add this server as a connection">
                                            <StackPanel Width="112">
                                                <Border Width="112" Height="63" Background="#E8F5E9" CornerRadius="4"
                                                        BorderBrush="#A5D6A7" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="18" Foreground="#43A047"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Margin="3" Padding="4,1" CornerRadius="2"
                                                                Background="#43A047">
                                                            <TextBlock Text="{Binding AuthModeText}" FontSize="9"
                                                                       Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#1B5E20"
                                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding EndpointText}" FontSize="10" Foreground="#66BB6A" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!--  ====== 主体：左（分组树）+ 右（选中连接详情）  ======  -->
        <Grid Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：工具条 + 搜索 + 树  -->
            <DockPanel Grid.Column="0" Background="#FCFDFE">
                <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="#E8EDF1" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBox Height="28" Padding="8,0" VerticalContentAlignment="Center"
                                 FontSize="12" Background="#F5F7F9"
                                 BorderBrush="#D0D7DE" BorderThickness="1"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter by name or address" />
                        <TextBlock Text="Search name or address" FontSize="12" Foreground="#A7B4BE"
                                   VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <TreeView x:Name="ConnectionTree"
                          Padding="6,6"
                          Background="Transparent"
                          BorderThickness="0"
                          ItemsSource="{Binding Nodes}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Border x:Name="Row" Height="30" Background="Transparent" CornerRadius="3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                  ClickMode="Press" Focusable="False">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Padding="2">
                                                                    <Path x:Name="Arrow" Data="M 0 3 L 4 7 L 8 3 Z"
                                                                          Fill="#78909C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="False">
                                                                        <Setter TargetName="Arrow" Property="Data" Value="M 3 0 L 7 4 L 3 8 Z" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F1F5F9" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#E3F0FB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Connect"
                                                  Command="{Binding PlacementTarget.Tag.ConnectNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        <MenuItem Header="New Connection in Group..."
                                                  Command="{Binding PlacementTarget.Tag.NewConnectionInGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        <Separator />
                                        <MenuItem Header="Edit..."
                                                  Command="{Binding PlacementTarget.Tag.EditNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        <MenuItem Header="Rename..."
                                                  Command="{Binding PlacementTarget.Tag.RenameNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        <MenuItem Header="Rename Group..."
                                                  Command="{Binding PlacementTarget.Tag.RenameGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        <MenuItem Header="Delete Group"
                                                  Command="{Binding PlacementTarget.Tag.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                        <MenuItem Header="Delete"
                                                  Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid Height="28"
                                  AutomationProperties.Name="{Binding DisplayName}"
                                  behaviors:DoubleClickCommand.Command="{Binding DataContext.ConnectNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                <Setter Property="Background" Value="#F4F6F8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RowGlyph" Grid.Column="0" Text="&#xE7F4;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#78909C"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="7" Height="7"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Margin="-11,0,0,0" Fill="#CFD8DC" />
                                <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding DisplayName}"
                                           FontSize="12.5" Foreground="#263238" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DetailText" Grid.Column="2" Text="{Binding Detail}"
                                           FontSize="10.5" Foreground="#90A4AE" VerticalAlignment="Center"
                                           Margin="8,0,6,0" />
                            </Grid>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter TargetName="RowGlyph" Property="Text" Value="&#xE8B7;" />
                                    <Setter TargetName="RowGlyph" Property="Foreground" Value="#1565C0" />
                                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Availability}" Value="Online">
                                    <Setter TargetName="StatusDot" Property="Fill" Value="#43A047" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Availability}" Value="Offline">
                                    <Setter TargetName="StatusDot" Property="Fill" Value="#E53935" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUngrouped}" Value="True">
                                    <Setter TargetName="RowGlyph" Property="Text" Value="&#xE8F4;" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <Border Grid.Column="1" Width="1" Background="#E8EDF1" />

            <!--  右侧：选中连接详情  -->
            <Grid Grid.Column="2" Background="White" Margin="24,20">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Height="230" Width="360" HorizontalAlignment="Left"
                            Background="#0B1220" CornerRadius="6">
                        <Grid>
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                       Foreground="#3D5568" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding SelectedThumbnail}" Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding SelectedName}" FontSize="20" FontWeight="SemiBold"
                               Foreground="#1B2A36" Margin="0,16,0,2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedAddress}" FontSize="13" Foreground="#607D8B" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding SelectedAvailabilityText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#43A047" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding SelectedGroupText}" FontSize="12" Foreground="#78909C" />
                        <TextBlock Text="   ·   " FontSize="12" Foreground="#B0BEC5" />
                        <TextBlock Text="{Binding SelectedUserText}" FontSize="12" Foreground="#78909C" />
                        <TextBlock Text="   ·   " FontSize="12" Foreground="#B0BEC5" />
                        <TextBlock Text="{Binding SelectedLastConnectedText}" FontSize="12" Foreground="#78909C" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="Connect" Height="32" Width="110" Margin="0,0,8,0"
                                Command="{Binding ConnectSelectedCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="Edit" Height="32" Width="90" Margin="0,0,8,0"
                                Command="{Binding EditSelectedCommand}"
                                Style="{StaticResource LightButtonStyle}" />
                        <Button Content="Delete" Height="32" Width="90"
                                Command="{Binding DeleteSelectedCommand}"
                                Style="{StaticResource LightButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Select a connection on the left"
                               FontSize="13" Foreground="#A7B4BE" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Create a connection with + Connection, then double-click it"
                               FontSize="12" Foreground="#C2CDD6" Margin="0,6,0,0"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="hidden"
                           FontSize="1" Foreground="Transparent"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
