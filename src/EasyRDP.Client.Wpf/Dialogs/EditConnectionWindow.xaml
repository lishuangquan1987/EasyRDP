<Window x:Class="EasyRDP.Client.Wpf.Dialogs.EditConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:EasyRDP.Shared"
        Title="Edit Connection" Width="400" Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="Display name (leave empty to show the IP):" Margin="0,0,0,4"/>
        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                 Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Text="Address (IP or hostname):" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                 Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Text="Port:" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                 Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Text="Username (optional):" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Text="Password (optional):" Margin="0,0,0,4"/>
        <PasswordBox Height="26" Margin="0,0,0,8"
                     behaviors:PasswordBoxBehavior.BindPassword="True"
                     behaviors:PasswordBoxBehavior.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="72" Margin="0,0,8,0" IsDefault="True" Command="{Binding OkCommand}"/>
            <Button Content="Cancel" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
