<Window x:Class="EasyRDP.Client.Wpf.Dialogs.RenameConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Connection" Width="360" Height="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="显示名称（留空则恢复为 IP）：" Margin="0,0,0,6"/>
        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                 Height="26" VerticalContentAlignment="Center"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="72" Margin="0,0,8,0" IsDefault="True" Command="{Binding OkCommand}"/>
            <Button Content="Cancel" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
