<Window x:Class="EasyRDP.Server.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyRDP Server" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Status: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Text="Sessions: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SessionCount}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <TextBlock Text="Uptime: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Uptime}" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 控制栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" Margin="0,0,8,0"/>
            <Button Content="Start" Command="{Binding StartCommand}" Width="80" Margin="0,0,6,0"/>
            <Button Content="Stop" Command="{Binding StopCommand}" Width="80"/>
        </StackPanel>

        <!-- 日志列表 -->
        <ListBox Grid.Row="2" ItemsSource="{Binding LogEntries}" FontSize="11" FontFamily="Consolas"/>
    </Grid>
</Window>
