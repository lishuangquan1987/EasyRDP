<Window x:Class="EasyRDP.Server.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyRDP.Server.Wpf"
        xmlns:vm="clr-namespace:EasyRDP.Server.Wpf.ViewModels"
        xmlns:cv="clr-namespace:EasyRDP.Server.Wpf.Converters"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="EasyRDP Server"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        StateChanged="OnWindowStateChanged"
        Closing="OnWindowClosing">

    <Window.Resources>
        <cv:BoolToColorConverter x:Key="BoolToColor" />
        <cv:LogLevelToColorConverter x:Key="LogColor" />
        <local:AlyStatusToVisibilityConverter x:Key="AlyStatusToVis" />
        <vm:MainViewModel x:Key="VM" />
    </Window.Resources>

    <DockPanel DataContext="{StaticResource VM}">
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="文件">
                <MenuItem Header="清空日志" Command="{Binding ClearLogCommand}" />
                <Separator />
                <MenuItem Header="退出" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Command="{Binding AboutCommand}" />
                <MenuItem Header="{Binding AlyClientUpdateStr, FallbackValue='检查更新'}"
                          Command="{Binding CheckUpdateCommand}"
                          Visibility="{Binding AlyClientStatus, Converter={StaticResource AlyStatusToVis}}" />
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Padding="8,4">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10"
                             Fill="{Binding IsRunning, Converter={StaticResource BoolToColor}}"
                             Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="{x:Static fa:IconChar.Desktop}"
                                  Foreground="#666666" FontSize="12"
                                  Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Text>
                            <Binding Path="Clients.Count" StringFormat="客户端: {0}" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left: Config Card ===== -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,16,16,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="0.1" ShadowDepth="2" Direction="270" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- Section: Settings -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <fa:IconBlock Icon="{x:Static fa:IconChar.Cogs}"
                                      Foreground="#1A1A1A" FontSize="14"
                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="服务器设置" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center" />
                    </StackPanel>

                    <Label Content="端口" />
                    <TextBox Text="{Binding Config.Port, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="认证令牌" />
                    <TextBox Text="{Binding Config.AuthToken}" />

                    <Label Content="压缩类型" />
                    <ComboBox SelectedValue="{Binding Config.CompressType}" SelectedValuePath="Content"
                              Padding="6,4" BorderBrush="#E0E0E0" BorderThickness="1"
                              Margin="0,0,0,8">
                        <ComboBoxItem Content="Zlib" />
                        <ComboBoxItem Content="None" />
                    </ComboBox>

                    <Label Content="帧率 (1-60)" />
                    <TextBox Text="{Binding Config.FrameRate, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="最大客户端 (0=无限)" />
                    <TextBox Text="{Binding Config.MaxClients, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="#E8E8E8" Margin="0,8,0,8" />

                    <!-- Section: Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <fa:IconBlock Icon="{x:Static fa:IconChar.Play}"
                                      Foreground="#1A1A1A" FontSize="14"
                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="操作" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsStopped}"
                                Background="#107C10" Height="36" FontWeight="SemiBold" FontSize="13">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:IconBlock Icon="{x:Static fa:IconChar.Play}"
                                              Foreground="White" FontSize="12"
                                              Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="启动" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsRunning}"
                                Background="#D32F2F" Height="36" FontWeight="SemiBold" FontSize="13">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:IconBlock Icon="{x:Static fa:IconChar.Stop}"
                                              Foreground="White" FontSize="12"
                                              Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="停止" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="#F0F0F0"
                          BorderThickness="0"
                          ShowsPreview="True" />

            <!-- ===== Right: Clients + Log ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <!-- Client List Card -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.08" ShadowDepth="2" Direction="270" Color="#000000" />
                    </Border.Effect>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,12,14,8">
                            <fa:IconBlock Icon="{x:Static fa:IconChar.Users}"
                                          Foreground="#1A1A1A" FontSize="14"
                                          Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="已连接客户端"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ListView ItemsSource="{Binding Clients}"
                                  SelectedItem="{Binding SelectedClient}"
                                  AlternationCount="2"
                                  Margin="0,0,0,4">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#F0F0F0" />
                                    <Setter Property="Foreground" Value="#333333" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Padding" Value="6,4" />
                                </Style>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#F0F0F0" />
                                    <Style.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="#F9F9F9" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E8F0FE" />
                                            <Setter Property="Foreground" Value="#1A1A1A" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding SessionId}" Width="40" />
                                    <GridViewColumn Header="IP 地址" DisplayMemberBinding="{Binding RemoteEndPoint}" Width="130" />
                                    <GridViewColumn Header="状态" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <fa:IconBlock Icon="{x:Static fa:IconChar.Circle}"
                                                                  Foreground="{Binding IsAuthenticated, Converter={StaticResource BoolToColor}}"
                                                                  FontSize="8" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayStatus}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="帧数" DisplayMemberBinding="{Binding FrameCount}" Width="50" />
                                    <GridViewColumn Header="连接时间" DisplayMemberBinding="{Binding ConnectedAtDisplay}" Width="80" />
                                </GridView>
                            </ListView.View>
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="断开客户端" Command="{Binding DisconnectClientCommand}" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- Spacer -->
                <Rectangle Grid.Row="1" Fill="#F5F5F5" />

                <!-- Log Card -->
                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Opacity="0.08" ShadowDepth="2" Direction="270" Color="#000000" />
                    </Border.Effect>
                    <DockPanel>
                        <!-- Log header with clear button -->
                        <Grid DockPanel.Dock="Top" Margin="14,12,14,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <fa:IconBlock Icon="{x:Static fa:IconChar.List}"
                                              Foreground="#1A1A1A" FontSize="14"
                                              Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="日志"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding ClearLogCommand}"
                                    Height="26" FontSize="12" Padding="10,2"
                                    Background="#F0F0F0" Foreground="#666666"
                                    BorderThickness="1" BorderBrush="#E0E0E0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F0F0F0" />
                                        <Setter Property="Foreground" Value="#666666" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="#E0E0E0" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Padding" Value="10,2" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E0E0E0" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#D0D0D0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <fa:IconBlock Icon="{x:Static fa:IconChar.Times}"
                                                  Foreground="#666666" FontSize="11"
                                                  Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="清空" Foreground="#666666" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListBox ItemsSource="{Binding LogEntries}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Margin="2,0,2,4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="{Binding Level, Converter={StaticResource LogColor}}"
                                               FontFamily="Consolas" FontSize="11"
                                               Margin="12,1,4,1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
