<Window x:Class="EasyRDP.Server.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyRDP.Server.Wpf"
        Title="EasyRDP Server" Height="650" Width="950"
        MinHeight="500" MinWidth="700"
        Background="#1E1E2E" Foreground="#CDD6F4"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#181825"/>
        <SolidColorBrush x:Key="BgSurface" Color="#313244"/>
        <SolidColorBrush x:Key="BgOverlay" Color="#45475A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="Accent" Color="#89B4FA"/>
        <SolidColorBrush x:Key="AccentHover" Color="#74C7EC"/>
        <SolidColorBrush x:Key="Success" Color="#A6E3A1"/>
        <SolidColorBrush x:Key="Warning" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="Error" Color="#F38BA8"/>
        <SolidColorBrush x:Key="Border" Color="#45475A"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource Error}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgSecondary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="EasyRDP" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Server Dashboard" FontSize="14" Margin="12,0,0,0"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 指标卡片行 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 状态卡片 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Status" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource Success}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusLabel" Text="Stopped" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 端口卡片 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Port" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="PortLabel" Text="—" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- 会话数卡片 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Sessions" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="SessionCountLabel" Text="0" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- 运行时间卡片 -->
            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Uptime" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="UptimeLabel" Text="—" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 控制栏 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                    <TextBox x:Name="PortBox" Text="2000" Width="70" Margin="0,0,12,0"/>
                    <Button Content="Start Server" Style="{StaticResource PrimaryBtn}"
                            Click="StartBtn_Click" Width="120"/>
                    <Button Content="Stop Server" Style="{StaticResource DangerBtn}"
                            Click="StopBtn_Click" Width="120" Margin="12,0,0,0"
                            IsEnabled="False" x:Name="StopBtn"/>
                </StackPanel>
            </Grid>

            <!-- 会话列表和日志面板 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 会话列表 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Active Sessions" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ListView Grid.Row="1" x:Name="SessionList" Background="Transparent"
                                  BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" Width="45" DisplayMemberBinding="{Binding Id}"/>
                                    <GridViewColumn Header="Remote" Width="150" DisplayMemberBinding="{Binding Remote}"/>
                                    <GridViewColumn Header="Codec" Width="80" DisplayMemberBinding="{Binding Codec}"/>
                                    <GridViewColumn Header="Resolution" Width="100" DisplayMemberBinding="{Binding Resolution}"/>
                                    <GridViewColumn Header="Frames" Width="70" DisplayMemberBinding="{Binding Frames}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 日志面板 -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Activity Log" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <ListView Grid.Row="1" x:Name="LogList" Background="Transparent"
                                  BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                                  FontSize="11" FontFamily="Consolas">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondary}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底栏 -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="8,4"
                Background="{StaticResource BgSurface}" CornerRadius="6">
            <TextBlock x:Name="LogLine" Text="Ready" FontSize="11"
                       Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
