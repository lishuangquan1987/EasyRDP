<Window x:Class="EasyRDP.Server.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyRDP Server" Height="720" Width="940"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== 顶部工具栏（深色）：品牌 + 服务配置 ====== -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarDarkBrush}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="&#x25CF;" Foreground="{StaticResource StatusOkBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="EasyRDP Server" Style="{StaticResource BrandTextStyle}"/>
                </StackPanel>

                <!-- Port -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="PORT" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LightTextBoxStyle}" Width="72"/>
                </StackPanel>

                <!-- Username -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="USER" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LightTextBoxStyle}" Width="110"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="PASS" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                                 Style="{StaticResource LightPasswordBoxStyle}" Width="120"/>
                </StackPanel>

                <!-- 主操作按钮 -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save Settings" Style="{StaticResource ToolbarButtonStyle}" Height="30" Padding="12,0"
                            Command="{Binding SaveSettingsCommand}" Margin="0,0,6,0"
                            ToolTip="保存端口/用户名/密码到本地配置文件"/>
                    <Button Content="Start" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartCommand}" Margin="0,0,6,0"/>
                    <Button Content="Stop" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ====== 信息条（浅色）：服务状态 ====== -->
        <Border Grid.Row="1" Background="#F4F6F8"
                BorderBrush="#DDE3E8" BorderThickness="0,0,0,1" Padding="14,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusDot" Text="&#x25CF;" FontSize="11"
                           Foreground="{StaticResource StatusIdleBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Status: " Style="{StaticResource ActionLabelStyle}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                <TextBlock Text="Port: " Style="{StaticResource ActionLabelStyle}"/>
                <TextBlock Text="{Binding DisplayPort}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                <TextBlock Text="Sessions: " Style="{StaticResource ActionLabelStyle}"/>
                <TextBlock Text="{Binding SessionCount}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                <TextBlock Text="Uptime: " Style="{StaticResource ActionLabelStyle}"/>
                <TextBlock Text="{Binding Uptime}" Style="{StaticResource ActionValueStyle}"/>
            </StackPanel>
        </Border>

        <!-- ====== 中间：会话列表 ====== -->
        <Grid Grid.Row="2" Margin="14,12,14,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Sessions" Style="{StaticResource SectionHeaderStyle}"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernDataGridRowStyle}"
                      CellStyle="{StaticResource ModernDataGridCellStyle}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="*"/>
                    <DataGridTextColumn Header="Codec" Binding="{Binding Codec}" Width="130"/>
                    <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="120"/>
                    <DataGridTextColumn Header="Frames" Binding="{Binding Frames}" Width="90"/>
                    <DataGridTemplateColumn Header="Action" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Kick" Tag="{Binding IdValue}" Click="KickButton_Click"
                                        Style="{StaticResource LightButtonStyle}" Height="24" Padding="10,0"
                                        HorizontalAlignment="Left" Margin="6,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ====== 底部：日志 ====== -->
        <Grid Grid.Row="3" Margin="14,4,14,12" MinHeight="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Log" Style="{StaticResource SectionHeaderStyle}"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                     Style="{StaticResource LogListStyle}"/>
        </Grid>
    </Grid>
</Window>
