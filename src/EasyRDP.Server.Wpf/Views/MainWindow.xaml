<Window x:Class="EasyRDP.Server.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:proto="clr-namespace:EasyRDP.Core.Protocol;assembly=EasyRDP.Core"
        xmlns:models="clr-namespace:EasyRDP.Server.Wpf.Models"
        xmlns:behaviors="clr-namespace:EasyRDP.Shared"
        Title="EasyRDP Server" Height="720" Width="940"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- 帧变化检测模式枚举值（供 ComboBox 绑定） -->
        <ObjectDataProvider x:Key="ChangeDetectionModeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="proto:ChangeDetectionMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <!-- 认证模式枚举值：Password=口令认证，Approve=免密码人工审批 -->
        <ObjectDataProvider x:Key="AuthModeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ServerAuthMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== 顶部工具栏（深色）：品牌 + 服务配置 ====== -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarDarkBrush}" Padding="14,10">
            <!-- WrapPanel：分组总宽超过窗口时换行显示，避免 AUTH 下拉与 Start/Stop 被右边缘裁掉 -->
            <WrapPanel Orientation="Horizontal">
                <!-- 品牌 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                    <TextBlock Text="&#x25CF;" Foreground="{StaticResource StatusOkBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="EasyRDP Server" Style="{StaticResource BrandTextStyle}"/>
                </StackPanel>

                <!-- Port -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                    <TextBlock Text="PORT" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LightTextBoxStyle}" Width="72"/>
                </StackPanel>

                <!-- Username -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                    <TextBlock Text="USER" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource LightTextBoxStyle}" Width="110"/>
                </StackPanel>

                <!-- Password（审批模式下不需要口令，禁用输入框） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4"
                            IsEnabled="{Binding IsPasswordMode}">
                    <TextBlock Text="PASS" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <PasswordBox Style="{StaticResource LightPasswordBoxStyle}" Width="120"
                                 behaviors:PasswordBoxBehavior.BindPassword="True"
                                 behaviors:PasswordBoxBehavior.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- 帧变化检测模式：FullFrameMemcmp（原始 memcmp）/ BlockHashDirtyRect（块哈希） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                    <TextBlock Text="DETECT" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <ComboBox Width="170"
                              Style="{StaticResource ToolbarComboBoxStyle}"
                              IsReadOnly="True"
                              ItemsSource="{Binding Source={StaticResource ChangeDetectionModeValues}}"
                              SelectedItem="{Binding ChangeDetectionMode}"
                              ToolTip="帧变化检测模式：FullFrameMemcmp=原始全帧比对，BlockHashDirtyRect=块哈希小变化跳过编码。切换在下次会话接入时生效"/>
                </StackPanel>

                <!-- 认证模式：Password（挑战-响应口令）/ Approve（免密码，连接时人工确认） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                    <TextBlock Text="AUTH" Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                    <ComboBox Width="110"
                              Style="{StaticResource ToolbarComboBoxStyle}"
                              IsReadOnly="True"
                              ItemsSource="{Binding Source={StaticResource AuthModeValues}}"
                              SelectedItem="{Binding AuthMode}"
                              ToolTip="连接认证模式：Password=客户端输入 USER/PASS（挑战-响应，口令不上网）；Approve=客户端免密码，连接时本机弹窗确认。运行中切换立即生效"/>
                </StackPanel>

                <!-- 主操作按钮 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                    <Button Content="Save Settings" Style="{StaticResource ToolbarButtonStyle}" Height="30" Padding="12,0"
                            Command="{Binding SaveSettingsCommand}" Margin="0,0,6,0"
                            ToolTip="保存端口/用户名/密码/检测模式到本地配置文件"/>
                    <Button Content="Start" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartCommand}" Margin="0,0,6,0"/>
                    <Button Content="Stop" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopCommand}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ====== 信息条（浅色）：服务状态 ====== -->
        <Border Grid.Row="1" Background="#F4F6F8"
                BorderBrush="#DDE3E8" BorderThickness="0,0,0,1" Padding="14,6">
            <!-- WrapPanel：状态/显示器/启动开关三组在窄窗口下换行显示 -->
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,20,2">
                    <TextBlock x:Name="StatusDot" Text="&#x25CF;" FontSize="11"
                               Foreground="{StaticResource StatusIdleBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Status: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                    <TextBlock Text="Port: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding DisplayPort}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                    <TextBlock Text="Sessions: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding SessionCount}" Style="{StaticResource ActionValueStyle}" Margin="0,0,24,0"/>

                    <TextBlock Text="Uptime: " Style="{StaticResource ActionLabelStyle}"/>
                    <TextBlock Text="{Binding Uptime}" Style="{StaticResource ActionValueStyle}"/>

                    <!-- aly 自动更新：发现/下载/应用更新时显示状态，点击确认下载或应用 -->
                    <Button Content="{Binding AlyClientUpdateStr}" Style="{StaticResource LightButtonStyle}"
                            Command="{Binding CheckUpdateCommand}" Margin="16,0,0,0"
                            Visibility="{Binding IsUpdatePanelVisible, Converter={StaticResource BoolToVis}}"
                            ToolTip="点击确认下载/应用新版本"/>
                </StackPanel>

                <!-- 采集显示器：0=主屏，其余按系统枚举顺序；运行中切换立即重建编码器并发关键帧 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Display: " Style="{StaticResource ActionLabelStyle}" VerticalAlignment="Center"/>
                    <ComboBox Width="220" Style="{StaticResource ToolbarComboBoxStyle}" IsReadOnly="True"
                              ItemsSource="{Binding Displays}" DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedDisplay, Mode=TwoWay}"
                              ToolTip="采集目标显示器：0=主屏，其余按系统枚举顺序。运行中切换立即生效（重建编码器 + 发送关键帧 + 鼠标坐标原点同步偏移）"/>
                </StackPanel>

                <!-- 启动行为开关：开机自启（写 HKCU Run）+ 启动即监听 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding AutoStart, Mode=TwoWay}"
                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="随 Windows 登录自动启动（写入 HKCU\...\Run，仅当前用户，无需管理员权限）"/>
                    <CheckBox Content="Listen on launch"
                              IsChecked="{Binding AutoListen, Mode=TwoWay}"
                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="程序启动后立即开始监听；用户名/密码为空时跳过，填写后点 Start 即可"/>
                    <CheckBox Content="Discoverable"
                              IsChecked="{Binding AllowDiscovery, Mode=TwoWay}"
                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                              VerticalAlignment="Center"
                              ToolTip="允许局域网内客户端通过 UDP 自动发现本机（仅广播计算机名与端口，不含凭据）"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ====== 中间：会话列表 ====== -->
        <Grid Grid.Row="2" Margin="14,12,14,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Sessions" Style="{StaticResource SectionHeaderStyle}"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}"
                      Style="{StaticResource ModernDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ModernDataGridRowStyle}"
                      CellStyle="{StaticResource ModernDataGridCellStyle}"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="*"/>
                    <DataGridTextColumn Header="Codec" Binding="{Binding Codec}" Width="130"/>
                    <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="120"/>
                    <DataGridTextColumn Header="Frames" Binding="{Binding Frames}" Width="90"/>
                    <DataGridTemplateColumn Header="Action" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Send File"
                                            Command="{Binding DataContext.SendFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding IdValue}"
                                            Style="{StaticResource LightButtonStyle}" Height="24" Padding="8,0"
                                            Margin="6,0,0,0"
                                            ToolTip="Select files to send to this remote computer"/>
                                    <Button Content="Kick"
                                            Command="{Binding DataContext.KickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding IdValue}"
                                            Style="{StaticResource LightButtonStyle}" Height="24" Padding="10,0"
                                            HorizontalAlignment="Left" Margin="6,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 文件传输进度（服务端收发共用；仅在传输期间显示） -->
            <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8"
                    Background="#F4F6F8" BorderBrush="#DDE3E8" BorderThickness="1"
                    Visibility="{Binding IsFileTransferVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding FileTransferText}" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <ProgressBar Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding FileTransferPercent, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ====== 底部：日志 ====== -->
        <Grid Grid.Row="3" Margin="14,4,14,12" MinHeight="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Log" Style="{StaticResource SectionHeaderStyle}"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                     Style="{StaticResource LogListStyle}"/>
        </Grid>
    </Grid>
</Window>
