<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false">

  <targets>
    <!-- D18 日志降量：生产默认 minlevel=Info，DEBUG 日志（每帧编码统计/逐条收发/
         鼠标移动）占单会话日志 99.7%（26 万行/33MB），格式化+队列+磁盘 IO 是弱机
         CPU/内存压力源。排查问题时临时改回 Debug 即可获得全量细节。 -->
    <target xsi:type="AsyncWrapper" name="asyncLog" queueLimit="2000" overflowAction="Discard">
      <target name="logfile" xsi:type="File"
              fileName="${basedir}/Logs/easyrdp-server-${shortdate}.log"
              layout="${longdate} [${level:uppercase=true}] ${logger} - ${message} ${exception:format=tostring}"
              archiveEvery="Day"
              maxArchiveFiles="7"
              encoding="utf-8" />
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="asyncLog" />
  </rules>
</nlog>
