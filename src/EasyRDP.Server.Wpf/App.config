<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <runtime>
    <!-- 让 AccessViolationException 等损坏状态异常能传递到 try-catch / UnhandledException 处理器，
         默认 .NET 4.0+ 不传递 CSE 到托管代码。诊断 H264 编解码器原生调用崩溃问题时必需。
         注意：此配置仅在 .NET Framework 4.x 生效，.NET 8 上被忽略（无害）。 -->
    <legacyCorruptedStateExceptionsPolicy enabled="true" />
  </runtime>
</configuration>
