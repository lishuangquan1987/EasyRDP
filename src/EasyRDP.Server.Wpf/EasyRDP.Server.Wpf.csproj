<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EasyRDP.Core\EasyRDP.Core.csproj" />
    <ProjectReference Include="..\..\aly\client\aly-client-sdk\AlyClient.CSharpSDK\AlyClient.CSharpSDK\AlyClient.CSharpSDK.csproj" />
    <ProjectReference Include="..\..\EasyDesk\src\EasyDesk.Core\EasyDesk.Core.csproj" />
    <ProjectReference Include="..\..\EasyDesk\src\EasyDesk.Windows\EasyDesk.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RelayCommand.cs" Link="RelayCommand.cs" />
    <Compile Include="..\Shared\SecretProtector.cs" Link="SecretProtector.cs" />
    <Page Include="..\Shared\UiStyles.xaml" Link="UiStyles.xaml" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 服务端必须运行在 Windows XP 上，唯一目标 net40，禁止添加 net8.0-windows 等其他目标框架 -->
    <TargetFramework>net40</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 高语言版本（SDK Roslyn 可编译至 net40 IL） -->
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\libs\openh264\x86\openh264.dll" Link="openh264\x86\openh264.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\..\libs\openh264\x64\openh264.dll" Link="openh264\x64\openh264.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="NLog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
