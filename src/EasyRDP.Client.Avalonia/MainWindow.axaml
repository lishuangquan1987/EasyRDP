<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EasyRDP.Client.Avalonia.MainWindow"
        Title="EasyRDP Client (Avalonia)"
        Width="1024" Height="768"
        Focusable="True"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="连接" Command="{Binding ConnectCommand}" />
            <MenuItem Header="断开" Command="{Binding DisconnectCommand}" />
        </Menu>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Height="24"
                   VerticalAlignment="Center" Margin="4,0" />

        <!-- Connect Panel -->
        <Border IsVisible="{Binding IsDisconnected}" Padding="20">
            <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="连接到 EasyRDP 服务端" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Text="地址" />
                <TextBox Text="{Binding Host}" />
                <TextBlock Text="端口" />
                <TextBox Text="{Binding Port}" />
                <TextBlock Text="令牌" />
                <TextBox Text="{Binding Token}" />
                <Button Content="连接" Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding !IsConnecting}" Height="32" Margin="0,10" />
            </StackPanel>
        </Border>

        <!-- Remote Desktop -->
        <Border Background="Black" IsVisible="{Binding IsConnected}">
            <Image Source="{Binding FrameSource}" Stretch="Uniform"
                   PointerMoved="OnPointerMoved"
                   PointerPressed="OnPointerPressed"
                   PointerReleased="OnPointerReleased"
                   PointerWheelChanged="OnPointerWheel"
                   IsHitTestVisible="True" />
        </Border>
    </DockPanel>
</Window>
